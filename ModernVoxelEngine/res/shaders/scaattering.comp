#version 460
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// ============================================================================
// OUTPUT: 3D LUT (R16G16B16_SFLOAT)
// ============================================================================

layout(binding = 0, rgba16f) writeonly uniform image3D scatteringLUT;

// ============================================================================
// INPUT: transmittance LUT
// ============================================================================

layout(binding = 1) uniform sampler2D transmittanceLUT;

// ============================================================================
// UBO: atmosphere constants
// (Radius, Scattering Coefficients, Sun Direction…)
// ============================================================================

layout(std140, binding = 2) uniform AtmosphereUBO
{
    float Rg;               // ground radius
    float Rt;               // top atmosphere radius
    float HR;               // Rayleigh scale height
    float HM;               // Mie scale height

    vec3  betaR;            // Rayleigh coefficient
    float _pad0;

    vec3  betaM;            // Mie coefficient
    float mieG;             // anisotropy for Mie phase

    vec3  sunDir;
    float dummy0;

    float mu_s_min;         // auxiliary constants (for 3D LUT mapping)
    float mu_s_max;
    float viewHeightMin;
    float viewHeightMax;
};

// ============================================================================
// Utility
// ============================================================================

// Henyey–Greenstein Mie phase
float PhaseMie(float cosTheta, float g)
{
    float g2 = g * g;
    return (1.0 - g2) / (4.0 * 3.14159265 * pow(1.0 + g2 - 2.0 * g * cosTheta, 1.5));
}

// Rayleigh phase
float PhaseRayleigh(float cosTheta)
{
    return (3.0 / (16.0 * 3.14159265)) * (1.0 + cosTheta * cosTheta);
}

// Distance to sphere boundary (intersection)
bool RaySphereIntersect(vec3 ro, vec3 rd, float radius, out float t)
{
    float b = dot(ro, rd);
    float c = dot(ro, ro) - radius * radius;
    float h = b * b - c;
    if (h < 0.0)
    {
        t = 0.0;
        return false;
    }
    t = -b + sqrt(h);
    return (t >= 0.0);
}

// Compute transmittance by sampling precomputed LUT
vec3 ComputeTransmittance(vec3 pos, vec3 dir)
{
    float H = length(pos);
    float r = clamp((H - Rg) / (Rt - Rg), 0.0, 1.0);
    float mu = dot(pos, dir) / H;

    float u = clamp((mu + 1.0) * 0.5, 0.0, 1.0);
    float v = r;

    return texture(transmittanceLUT, vec2(u, v)).rgb;
}

// ============================================================================
// Mapping 3D LUT coordinates → physical parameters
// (height, view direction, sun direction)
// ============================================================================

void GetScatteringParameters(ivec3 id, ivec3 size,
                             out float height, out float mu, out float muS, out float nu)
{
    float x = (float(id.x) + 0.5) / float(size.x);
    float y = (float(id.y) + 0.5) / float(size.y);
    float z = (float(id.z) + 0.5) / float(size.z);

    // Height from ground [Rg, Rt]
    height = mix(Rg, Rt, y);

    // view angle (mu = cos(view zenith))
    mu = mix(-1.0, 1.0, x);

    // sun-view angle (nu = cos(angle between viewDir and sunDir))
    nu = mix(-1.0, 1.0, z);

    // mu_S = dot(viewDir, sunDir), alternative mapping:
    muS = nu; // simplest form
}

// ============================================================================
// Main single-scattering integral
// ============================================================================

void main()
{
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size  = imageSize(scatteringLUT);

    if (coord.x >= size.x ||
        coord.y >= size.y ||
        coord.z >= size.z)
        return;

    // -------- LUT → physical parameters -------------------------------------
    float height, mu, muS, nu;
    GetScatteringParameters(coord, size, height, mu, muS, nu);

    // -------- View direction -------------------------------------------------
    float r   = height;
    vec3  pos = vec3(0.0, r, 0.0);

    // view direction
    float sinTheta = sqrt(max(0.0, 1.0 - mu * mu));
    vec3 viewDir = normalize(vec3(sinTheta, mu, 0.0));

    // sun direction already defined by UBO
    float cosThetaSun = nu;

    // -------- Integrate along ray -------------------------------------------
    float tMax;
    if (!RaySphereIntersect(pos, viewDir, Rt, tMax))
    {
        imageStore(scatteringLUT, coord, vec4(0.0));
        return;
    }

    const int steps = 50;
    float dt = tMax / float(steps);

    vec3 accumR = vec3(0.0);
    vec3 accumM = vec3(0.0);

    float t = 0.0;

    for (int i = 0; i < steps; i++)
    {
        vec3 samplePos = pos + viewDir * (t + 0.5 * dt);
        float sampleH  = length(samplePos);

        // atmosphere density
        float densityR = exp(-(sampleH - Rg) / HR);
        float densityM = exp(-(sampleH - Rg) / HM);

        // transmittance from sample to space (sun)
        vec3 sunTrans = ComputeTransmittance(samplePos, sunDir);

        // transmittance from observer to sample
        vec3 viewTrans = ComputeTransmittance(pos, viewDir);

        // single scattering contribution
        accumR += densityR * sunTrans * viewTrans * dt;
        accumM += densityM * sunTrans * viewTrans * dt;

        t += dt;
    }

    // Apply phase functions
    vec3 rayleigh = accumR * PhaseRayleigh(cosThetaSun) * betaR;
    vec3 mie      = accumM * PhaseMie(cosThetaSun, mieG) * betaM;

    vec3 result = rayleigh + mie;

    // Write into the 3D LUT
    imageStore(scatteringLUT, coord, vec4(result, 1.0));
}